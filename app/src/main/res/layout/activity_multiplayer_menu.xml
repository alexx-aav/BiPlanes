<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color">

    <!-- Анимированный фон с облаками и самолетами -->
    <com.example.biplanes.game.ui.MenuPlaneView
        android:id="@+id/backgroundView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Мультиплеер"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:shadowColor="#80000000"
        android:shadowDx="3"
        android:shadowDy="3"
        android:shadowRadius="5"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="24dp"/>

    <androidx.cardview.widget.CardView
        android:id="@+id/gameOptionsCard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#B0FFFFFF"
        app:layout_constraintTop_toBottomOf="@+id/titleText"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintWidth_max="900dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- Левая панель с радиокнопками -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#10000000"
                android:layout_marginEnd="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Выберите режим игры:"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <RadioGroup
                    android:id="@+id/gameTypeRadioGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/oneVsOneRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1 на 1"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:padding="8dp"
                        android:checked="true"
                        android:layout_marginBottom="6dp"/>

                    <RadioButton
                        android:id="@+id/twoVsTwoRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2 на 2"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:padding="8dp"
                        android:layout_marginBottom="6dp"/>

                    <RadioButton
                        android:id="@+id/freeForAllRadio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Каждый сам за себя"
                        android:textSize="20sp"
                        android:textColor="#000000"
                        android:padding="8dp"/>

                </RadioGroup>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Выберите тип игры и нажмите одну из кнопок справа"
                    android:textSize="16sp"
                    android:textStyle="italic"
                    android:textColor="#555555"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>

            </LinearLayout>

            <!-- Правая панель с кнопками -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="10dp"
                android:background="#10000000"
                android:layout_marginStart="6dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Действия:"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#000000"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/createGameButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Создать игру"
                    android:textSize="18sp"
                    style="@style/GameButton"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/joinGameButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Присоединиться к игре"
                    android:textSize="18sp"
                    style="@style/GameButton"
                    android:layout_marginBottom="12dp"/>
                
                <Button
                    android:id="@+id/backButton"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="Назад"
                    android:textSize="18sp"
                    style="@style/GameButton"
                    android:layout_marginBottom="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>

                <ImageView
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:src="@drawable/plane"
                    android:layout_gravity="center"
                    android:alpha="0.5"
                    android:rotation="45"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout> 